{
  "name": "mirai-ai-robot",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm:server\" \"npm:client\"",
    "server": "node server/server.js",
    "client": "vite --host 0.0.0.0",
    "build": "vite build",
    "build:gh": "cross-env GITHUB_PAGES=true vite build",
    "start": "node server/server.js",
    "deploy": "npm run build:gh && gh-pages -d dist"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "openai": "^5.12.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "gh-pages": "^6.3.0",
    "vite": "^5.4.11"
  }
}